<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <!-- Conteneur défilable du contenu de l'écran détail -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="80dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO IMAGE AVEC BOUTONS FLOTTANTS -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <!-- Image principale arrondie aux angles inférieurs -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/imgHero"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/house_sample_1"
                        android:contentDescription="@string/app_name" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Bouton Flottant RETOUR (Haut Gauche) -->
                <FrameLayout
                    android:id="@+id/btnBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_circle_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="Retour" />
                </FrameLayout>

                <!-- Boutons Flottants PARTAGER & FAVORI (Haut Droite) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="horizontal">

                    <!-- Bouton Partager -->
                    <FrameLayout
                        android:id="@+id/btnShare"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_circle_button"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_share"
                            android:contentDescription="Partager" />
                    </FrameLayout>

                    <!-- Bouton Favori -->
                    <FrameLayout
                        android:id="@+id/btnFavoriDetail"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_circle_button"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/imgFavoriDetail"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_heart_outline"
                            app:tint="@color/heart_pink"
                            android:contentDescription="@string/nav_favorites" />
                    </FrameLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- CORPS DES DÉTAILS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- Titre & Prix alignés sur la même ligne -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDetailTitre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="Duplex Moderne Riviera"
                        android:textColor="@color/text_primary"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/tvDetailPrix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="250k AR/m"
                        android:textColor="@color/primary_blue"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Adresse avec icône pin -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/text_secondary"
                        android:contentDescription="Adresse" />

                    <TextView
                        android:id="@+id/tvDetailAdresse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif"
                        android:text="Cocody Riviera 3, Abidjan, Côte d'Ivoire"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- BADGES DE CARACTÉRISTIQUES (3 Chambres, 2 SdB, 120 m², Meublé) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Badge Chambres -->
                        <TextView
                            android:id="@+id/badgeChambres"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_characteristic_badge"
                            android:fontFamily="sans-serif-medium"
                            android:text="3 Chambres"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <!-- Badge SdB -->
                        <TextView
                            android:id="@+id/badgeSdb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_characteristic_badge"
                            android:fontFamily="sans-serif-medium"
                            android:text="2 SdB"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <!-- Badge Superficie -->
                        <TextView
                            android:id="@+id/badgeSuperficie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_characteristic_badge"
                            android:fontFamily="sans-serif-medium"
                            android:text="120 m²"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <!-- Badge Meublé -->
                        <TextView
                            android:id="@+id/badgeMeuble"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_characteristic_badge"
                            android:fontFamily="sans-serif-medium"
                            android:text="Meublé"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- SECTION DESCRIPTION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/section_description"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="4dp"
                    android:text="Ce magnifique duplex meublé, situé en plein cœur de la Riviera 3, offre des prestations haut de gamme avec une cuisine équipée, un grand salon lumineux et une sécurité 24h/24. Idéal pour une famille ou un cadre dynamique."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- SECTION LOCALISATION / AGENT -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/section_location"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <!-- Carte profil agent et aperçu de situation géographique -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/imgAgentAvatar"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/sample_agent_avatar"
                            android:contentDescription="Photo de l'agent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAgentNom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Amadou Koné"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvAgentRole"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Agent Certifié Fediko"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Aperçu Plan / Tag localisation stylisé -->
                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_agent_card">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="sans-serif-medium"
                                android:text="Riviera 3"
                                android:textColor="#2E7D32"
                                android:textSize="11sp" />
                        </FrameLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BARRE FIXE D'ACTION INFÉRIEURE : CONTACER & RÉSERVER -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_gravity="bottom"
        android:background="@color/card_background"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Bouton Contacter (Pill lilas/violet) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContacter"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_contact"
            android:fontFamily="sans-serif-bold"
            android:text="@string/btn_contact"
            android:textAllCaps="false"
            android:textColor="@color/contact_purple_text"
            android:textSize="15sp" />

        <!-- Bouton Réserver (Pill bleu éclatant) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReserver"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_reserver"
            android:fontFamily="sans-serif-bold"
            android:text="@string/btn_reserve"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="15sp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
